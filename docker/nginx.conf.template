# web.mode = "proxy": the server renders its own UI; nginx is the in-cluster front door.
# Rendered by the nginx image entrypoint (envsubst): ${API_UPSTREAM}
server {
    listen 8080;
    server_name _;
    # Backup archives are uploaded through here to be restored; stream them, do not buffer.
    client_max_body_size 4g;

    location = /nginx-health { access_log off; return 200 "ok\n"; }

    location / {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Terminals are WebSockets: pass the upgrade through, and keep idle ones open
        # (the server pings every 20 s, so 1 h is only reached by a dead peer).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}

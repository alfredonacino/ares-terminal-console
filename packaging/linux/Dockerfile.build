# Builder for the Linux packages: Debian 11 (glibc 2.31) plus binutils, which PyInstaller needs (objdump),
# and the system libraries Qt WebEngine loads, so the window can be frozen and the self-test can import it.
FROM python:3.12-slim-bullseye
# Debian 11 is out of support: its security pool lives on archive.debian.org now.
RUN sed -i 's|http://deb.debian.org/debian-security|http://archive.debian.org/debian-security|' /etc/apt/sources.list \
 && apt-get update -qq && apt-get install -y -qq --no-install-recommends binutils libatomic1 \
      libnss3 libxkbcommon0 libxkbcommon-x11-0 libfontconfig1 libgl1 libegl1 libglib2.0-0 libdbus-1-3 \
      libxcb-cursor0 libxcomposite1 libxdamage1 libxrandr2 libxtst6 libxkbfile1 libasound2 libxshmfence1 \
      libgbm1 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
      libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 >/dev/null && rm -rf /var/lib/apt/lists/*

# Per-project deployment target for ./deploy.sh
#
#   cp .env.deploy.example .env.deploy    then fill in what differs
#
# Only needed to override the machine default in ~/.claude/deploy/target.env,
# or on a machine that has no such file. .env.deploy is git-ignored and is not
# rsynced to the server, so a server's identity never enters the repository.
#
# Precedence: environment > .env.deploy > ~/.claude/deploy/target.env

# Hostname or IP to deploy to. SSH must already work non-interactively.
DEPLOY_HOST=

# SSH user. Falls back to the machine default, then your local username.
DEPLOY_USER=

# Base directory on the server; the app lands in $DEPLOY_BASE/<app name>.
DEPLOY_BASE=

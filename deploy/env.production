# Non-secret preproduction settings, appended to .env on the FIRST deploy (missing keys on later deploys).
# Secrets (APP_KEY) are generated by deploy.sh (see GENERATE_SECRETS). app/main.py reads this .env.
# DATA_DIR is left unset: the server keeps its state in ./data beside the code (excluded from rsync).
ARES_ENVIRONMENT=pre
LOG_FORMAT=json
LOG_LEVEL=info
